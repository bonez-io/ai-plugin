{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/bonez-session-sync.mjs\" hook codex session-start",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/bonez-recall-hook.mjs\" codex",
            "timeout": 5
          },
          {
            "type": "mcp_tool",
            "server": "bonez",
            "tool": "memory_recall",
            "input": {},
            "timeout": 8
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/bonez-session-sync.mjs\" hook codex session-end",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/bonez-recall-hook.mjs\" codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
