{
  "version": 1,
  "hooks": {
    "beforeMCPExecution": [
      {
        "command": "./hooks/gate-write.sh"
      }
    ],
    "sessionEnd": [
      {
        "command": "./hooks/session-sync.sh",
        "timeout": 10
      }
    ],
    "sessionStart": [
      {
        "command": "./hooks/session-sync-catchup.sh",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "./hooks/session-sync-turn.sh",
        "timeout": 10
      }
    ]
  }
}
