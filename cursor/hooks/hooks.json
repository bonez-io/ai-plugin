{
  "version": 1,
  "hooks": {
    "beforeMCPExecution": [
      {
        "command": "./hooks/gate-write.sh"
      }
    ],
    "stop": [
      {
        "command": "\"${HOME}/.bonez/cursor-hook.sh\" turn-end",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "./hooks/session-sync.sh session-end",
        "timeout": 10
      }
    ],
    "sessionStart": [
      {
        "command": "./hooks/session-sync.sh session-start",
        "timeout": 10
      }
    ]
  }
}
