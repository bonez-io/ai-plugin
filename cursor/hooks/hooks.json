{
  "version": 1,
  "hooks": {
    "beforeMCPExecution": [
      {
        "command": "bash ./hooks/gate-write.sh",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "bash ./hooks/session-sync.sh session-end",
        "timeout": 10
      }
    ],
    "sessionStart": [
      {
        "command": "bash ./hooks/session-sync.sh session-start",
        "timeout": 10
      }
    ]
  }
}
