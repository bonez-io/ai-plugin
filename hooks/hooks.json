{
  "description": "Permission gate for bonez writes (prompts before the bonez MCP `memory_save` and `rules_write` tools run; reads such as `rules_read` pass through untouched), plus opt-in session capture: at SessionEnd it hands the transcript to bonez-session-sync.mjs, and at SessionStart it flushes any session in this workspace whose SessionEnd never fired (a crash, a kill, or the plugin having been disabled). Both are a silent no-op until `login` (or, headless, `install`) has been run (see README \u2014 Session capture).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "__(memory_save|rules_write)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate-write.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bonez-session-sync.mjs\" hook claude session-end",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bonez-session-sync.mjs\" hook claude session-start",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bonez-recall-hook.mjs\" claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Read|Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bonez-recall-hook.mjs\" claude",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^mcp__plugin_bonez_bonez__system_model_fetch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bonez-recall-hook.mjs\" claude",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bonez-recall-hook.mjs\" claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
