# Every text file is LF in the index AND in the working tree, on every OS.
#
# Why it matters: Git for Windows defaults to core.autocrlf=true, which checks text out as CRLF. A
# CRLF shell script fails ("bash\r: No such file", "syntax error near unexpected token $'\r'"), and the
# write gate (hooks/gate-write.sh) fails OPEN, so writes would go through unprompted. CRLF also breaks
# the byte-identical copies CI compares (cursor/ vs the root), and any file whose hash is pinned.
# An explicit eol=lf wins over the user's core.autocrlf for this repo, so a Windows clone gets LF.
* text=auto eol=lf

*.sh    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf
*.ps1   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
LICENSE        text eol=lf

# Binary: never touched.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.gz   binary
*.zip  binary
*.tgz  binary
